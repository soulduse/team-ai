{
  "name": "teamai-cli",
  "version": "0.1.0",
  "description": "Multi-account relay for Claude Code and Codex CLI",
  "type": "module",
  "bin": { "teamai": "dist/src/cli.js", "tai": "dist/src/cli.js" },
  "files": ["dist/src", "LICENSE", "NOTICE", "README.md", "SECURITY.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/**/*.test.ts",
    "lint": "eslint src test",
    "start": "node dist/src/cli.js"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "keywords": ["claude-code", "codex-cli", "oauth", "multi-account", "proxy"],
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
